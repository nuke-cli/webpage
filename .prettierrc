{
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }],
  "printWidth": 100,
	"proseWrap": "always",
	"tabWidth": 2,
	"useTabs": true,
	"singleQuote": true,
	"semi": true,
	"arrowParens": "always",
	"jsxBracketSameLine": true,
	"bracketSpacing": true
}